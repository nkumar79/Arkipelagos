# ═══════════════════════════════════════════════════════
#  Arkipelagos — HTTP Response Headers
#
#  host that supports a _headers file.
#
#  CSP here mirrors the <meta> CSP in index.html with
#  one addition: frame-ancestors 'none' — which is
#  silently ignored in <meta> tags per the W3C spec
#  and MUST be set via HTTP header.
#
#  If you update CSP in index.html, update it here too.
# ═══════════════════════════════════════════════════════

# ── All Routes ─────────────────────────────────────────

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=(), browsing-topics=()
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; base-uri 'none'; object-src 'none'; form-action 'none'; frame-ancestors 'none'; img-src 'self' data: https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com data:; script-src 'self' 'unsafe-inline' https://*.googletagmanager.com https://*.google-analytics.com; upgrade-insecure-requests

# ── HTML — short cache, always revalidate ──────────────

/index.html
  Cache-Control: public, max-age=3600, must-revalidate

# ── Immutable Assets — long cache (30 days) ────────────

/favicon.ico
  Cache-Control: public, max-age=2592000, immutable

/favicon-16.png
  Cache-Control: public, max-age=2592000, immutable

/favicon-32.png
  Cache-Control: public, max-age=2592000, immutable

/apple-touch-icon.png
  Cache-Control: public, max-age=2592000, immutable

/og.png
  Cache-Control: public, max-age=2592000, immutable

# ── Machine-Readable — moderate cache (1 day) ──────────

/sitemap.xml
  Cache-Control: public, max-age=86400, must-revalidate

/llms.txt
  Cache-Control: public, max-age=86400, must-revalidate

/robots.txt
  Cache-Control: public, max-age=86400, must-revalidate
